[Unit]
Description=Gate.io SQZMOM + IBS + SuperTrend BTC Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/gateio_btc_smi_ibs_supertrend
EnvironmentFile=%h/gateio_btc_smi_ibs_supertrend/.env
ExecStart=%h/gateio_btc_smi_ibs_supertrend/.venv/bin/python %h/gateio_btc_smi_ibs_supertrend/main.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateio-btc-smi-ibs-supertrend

[Install]
WantedBy=multi-user.target
